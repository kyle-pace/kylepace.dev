---
// The hub's header. Projects on kylepace.dev/<slug>/ use the same one, so the site
// reads as one place: the wordmark goes home, and kylepace.net is one click away.
---

<header class="site-header">
  <a class="name" href="https://kylepace.dev/">kylepace<span class="tld">.dev</span></a>
  <nav aria-label="Main">
    <ul>
      <li><a href="https://kylepace.dev/">Experiments</a></li>
      <li><a class="home" href="https://kylepace.net/">kylepace.net</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    width: min(100% - 2 * var(--space-6), var(--wide));
    margin-inline: auto;
    padding-block: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    justify-content: space-between;
    view-transition-name: site-header;
  }

  .name {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .tld {
    color: var(--accent-ink);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a.home {
    color: var(--accent-ink);
    font-weight: 600;
  }
</style>
