---
// "In progress" pill. Renders nothing for published projects.
import { statusLabels, type Status } from '../lib/status';

interface Props {
  status: Status;
}

const { status } = Astro.props;
---

{status === 'in-progress' && <span class:list={['status', status]}>{statusLabels[status]}</span>}

<style>
  .status {
    display: inline-block;
    padding: 0.1em 0.6em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    line-height: 1.5;
    vertical-align: middle;
  }

  .in-progress {
    border: 1px solid var(--accent-ink);
    color: var(--accent-ink);
  }
</style>
