---
import SocialBadges from './SocialBadges.astro';

const year = new Date().getFullYear();

// Progress Pride flag colors, chevron first, then the rainbow (tokens.css). Each dot's
// meaning is read aloud by screen readers.
const pride = [
  { color: 'white', label: 'White: trans and nonbinary people, and people who are transitioning' },
  { color: 'pink', label: 'Pink: trans women and girls' },
  { color: 'light-blue', label: 'Light blue: trans men and boys' },
  { color: 'brown', label: 'Brown: LGBTQ+ people of color' },
  { color: 'black', label: 'Black: LGBTQ+ people of color, and those living with and lost to HIV and AIDS' },
  { color: 'red', label: 'Red: life' },
  { color: 'orange', label: 'Orange: healing' },
  { color: 'yellow', label: 'Yellow: sunlight' },
  { color: 'green', label: 'Green: nature' },
  { color: 'blue', label: 'Blue: harmony' },
  { color: 'violet', label: 'Violet: spirit' },
];
---

<footer class="site-footer">
  <nav class="links" aria-label="Elsewhere">
    <a href="https://kylepace.net/">kylepace.net</a>
    <a href="https://kylepace.net/about/">About Kyle</a>
    <a href="https://github.com/kyle-pace">GitHub</a>
    <a href="mailto:mail@kylepace.net" data-copy-email>Email</a>
    <a href="https://kylepace.dev/accessibility/">Accessibility</a>
    <a href="https://kylepace.dev/privacy/">Privacy</a>
  </nav>
  <div class="bottom">
    <div class="open-door">
      <ul class="pride" aria-label="Progress Pride flag colors">
        {
          pride.map(({ color, label }, i) => (
            <li style={`--c: var(--pride-${color}); --i: ${i}`} aria-label={label} />
          ))
        }
      </ul>
      <p>
        My door’s open.{' '}
        <a href="https://kylepace.net/open-door/">Say hi</a>
      </p>
    </div>
    <div class="elsewhere">
      <SocialBadges />
      <p class="muted">© {year} Kyle Pace</p>
    </div>
  </div>
  <p class="copied" role="status" aria-live="polite" hidden>
    <span>Copied mail@kylepace.net</span>
    <a href="mailto:mail@kylepace.net">Open mail app</a>
  </p>
</footer>

<script>
  // Email: copy the address and say so, with the mail app one tap away. Falls back to
  // the mailto link if the clipboard isn't available (or a modifier key is held).
  const emailLink = document.querySelector<HTMLAnchorElement>('[data-copy-email]');
  const copied = document.querySelector<HTMLElement>('.copied');
  let hideTimer = 0;
  emailLink?.addEventListener('click', async (event) => {
    if (!navigator.clipboard || !copied || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    try {
      await navigator.clipboard.writeText('mail@kylepace.net');
    } catch {
      location.href = emailLink.href;
      return;
    }
    copied.hidden = false;
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => (copied.hidden = true), 4000);
  });

  // The page's playful moment: each dot lifts and grows as the pointer gets close,
  // so the row ripples under the cursor. Pointer devices only, never with reduced motion.
  const area = document.querySelector<HTMLElement>('.open-door');
  const dots = [...document.querySelectorAll<HTMLElement>('.pride li')];
  const allowed = window.matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)');
  let frame = 0;

  const reset = () => dots.forEach((dot) => (dot.style.removeProperty('--lift'), dot.style.removeProperty('--grow')));

  area?.addEventListener('pointermove', (event) => {
    if (!allowed.matches || document.documentElement.dataset.motion === 'reduce') return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      for (const dot of dots) {
        const box = dot.getBoundingClientRect();
        const distance = Math.hypot(event.clientX - (box.left + box.width / 2), (event.clientY - (box.top + box.height / 2)) / 2);
        const pull = Math.max(0, 1 - distance / 56);
        dot.style.setProperty('--lift', `${(-9 * pull).toFixed(1)}px`);
        dot.style.setProperty('--grow', (1 + 0.45 * pull).toFixed(2));
      }
    });
  });
  area?.addEventListener('pointerleave', () => {
    cancelAnimationFrame(frame);
    reset();
  });
</script>

<style>
  .site-footer {
    width: min(100% - 2 * var(--space-6), var(--wide));
    margin-inline: auto;
    padding-block: var(--space-8) var(--space-12);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .links a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  a {
    color: var(--ink);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-8);
  }

  .bottom p {
    margin: 0;
  }

  .elsewhere {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .open-door {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    color: var(--ink-muted);
  }

  .pride {
    display: flex;
    gap: 0.3rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
  }

  .pride li {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
  }

  /* The dot itself; the pointer script moves it with --lift and --grow. */
  .pride li::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--c);
    /* A thin ring so white shows on light backgrounds and black on dark ones. */
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink), transparent 80%);
    translate: 0 var(--lift, 0);
    scale: var(--grow, 1);
  }


  /* "Copied" note for the Email link: a small pill at the bottom of the screen. */
  .copied {
    position: fixed;
    left: 50%;
    bottom: var(--space-6);
    z-index: 50;
    translate: -50% 0;
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin: 0;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }

  .copied[hidden] {
    display: none;
  }

  .copied a {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg), transparent 85%);
    color: var(--bg);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .copied:not([hidden]) {
      animation: copied-in var(--duration) var(--ease-out);
    }

    @keyframes copied-in {
      from { opacity: 0; translate: -50% 0.75rem; }
    }
  }

  .open-door a {
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* The dots follow the pointer (script above sets translate and scale). */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .pride li::before {
      transition:
        translate var(--duration-fast) var(--ease-out),
        scale var(--duration-fast) var(--ease-out);
    }
  }
</style>
