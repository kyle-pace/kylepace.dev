---
/*
  Display settings: a floating button on every page that opens a panel of
  reading options. Each choice is a data attribute on <html>, styled in
  global.css, saved in this browser only (localStorage), and applied before
  paint by the inline script in Base.astro. The site is built to be
  accessible without any of this; these are extra preferences.
*/
const settings = [
  {
    key: 'theme',
    label: 'Theme',
    options: [
      ['auto', 'Device'],
      ['light', 'Light'],
      ['dark', 'Dark'],
    ],
  },
  {
    key: 'text',
    label: 'Text size',
    options: [
      ['default', 'Default'],
      ['large', 'Large'],
      ['larger', 'Larger'],
    ],
  },
  {
    key: 'contrast',
    label: 'Contrast',
    options: [
      ['auto', 'Device'],
      ['default', 'Standard'],
      ['more', 'More'],
    ],
  },
  {
    key: 'font',
    label: 'Font',
    options: [
      ['default', 'Hyperlegible'],
      ['system', 'Device font'],
    ],
  },
  {
    key: 'spacing',
    label: 'Spacing',
    options: [
      ['default', 'Default'],
      ['wide', 'Wide'],
    ],
  },
  {
    key: 'motion',
    label: 'Motion',
    options: [
      ['auto', 'Device'],
      ['reduce', 'Reduce'],
    ],
  },
  {
    key: 'links',
    label: 'Links',
    options: [
      ['default', 'Default'],
      ['underline', 'Underline all'],
    ],
  },
] as const;
---

<button class="display-toggle" type="button" popovertarget="site-display-settings" aria-label="Display and accessibility settings">
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="4.5" r="2" fill="currentColor"></circle>
    <path
      d="M4 8.5c2.6.8 5.3 1.2 8 1.2s5.4-.4 8-1.2M12 9.7v5m0 0-3.5 6.8M12 14.7l3.5 6.8"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<div id="site-display-settings" class="panel" popover role="dialog" aria-labelledby="site-display-settings-title">
  <div class="panel-head">
    <h2 id="site-display-settings-title">Display settings</h2>
    <button type="button" class="close" popovertarget="site-display-settings" popovertargetaction="hide" aria-label="Close display settings">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <form class="options">
    {
      settings.map((setting) => (
        <fieldset>
          <legend>{setting.label}</legend>
          <div class="segmented">
            {setting.options.map(([value, label], index) => (
              <label>
                <input type="radio" name={setting.key} value={value} checked={index === 0} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
  </form>
  <div class="panel-foot">
    <button type="button" class="reset">Reset</button>
    <a href="https://kylepace.dev/accessibility/">Accessibility statement</a>
  </div>
  <p class="note">Saved in this browser only.</p>
</div>

<script>
  const STORAGE_KEY = 'kp-display';
  const root = document.documentElement;
  const panel = document.getElementById("site-display-settings") as HTMLElement | null;
  const form = panel?.querySelector('form');

  // The first option of each setting is the default, which removes the attribute.
  const defaults = new Map<string, string>();
  form?.querySelectorAll<HTMLInputElement>('fieldset').forEach((fieldset) => {
    const first = fieldset.querySelector<HTMLInputElement>('input');
    if (first) defaults.set(first.name, first.value);
  });

  function load(): Record<string, string> {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch {
      return {};
    }
  }

  function save(values: Record<string, string>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(values));
    } catch {
      // Storage can be unavailable (private modes, embedded views); settings still apply for this page.
    }
  }

  function apply(values: Record<string, string>) {
    for (const key of defaults.keys()) {
      if (values[key]) root.dataset[key] = values[key];
      else delete root.dataset[key];
      const input = form?.querySelector<HTMLInputElement>(`input[name="${key}"][value="${values[key] ?? defaults.get(key)}"]`);
      if (input) input.checked = true;
    }
  }

  apply(load());

  form?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const values = load();
    if (input.value === defaults.get(input.name)) delete values[input.name];
    else values[input.name] = input.value;
    save(values);
    apply(values);
  });

  panel?.querySelector('.reset')?.addEventListener('click', () => {
    save({});
    apply({});
  });

  // Move focus into the panel when it opens; the browser returns it to the button on close.
  panel?.addEventListener('toggle', (event) => {
    if ((event as ToggleEvent).newState === 'open') {
      panel.querySelector<HTMLInputElement>('input:checked')?.focus();
    }
  });

  // "Reduce motion" also skips the page transitions between pages.
  const skipIfReduced = (event: Event) => {
    if (root.dataset.motion === 'reduce') {
      (event as Event & { viewTransition?: { skipTransition(): void } }).viewTransition?.skipTransition();
    }
  };
  window.addEventListener('pageswap', skipIfReduced);
  window.addEventListener('pagereveal', skipIfReduced);
</script>

<style>
  .display-toggle {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 2px solid var(--bg);
    border-radius: 999px;
    background: var(--accent-ink);
    color: var(--bg);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.18);
    cursor: pointer;
  }

  /* Clicks land on the button itself, not the icon inside it. */
  button svg {
    pointer-events: none;
  }

  .panel {
    position: fixed;
    inset: auto var(--space-4) calc(var(--space-4) + 3.5rem) auto;
    width: min(22rem, calc(100vw - 2 * var(--space-4)));
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.2);
    font-size: var(--step--1);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  h2 {
    margin: 0;
    font-size: var(--step-1);
  }

  .close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(-1 * var(--space-2));
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .options {
    display: grid;
    gap: var(--space-4);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .segmented {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .segmented label {
    position: relative;
    flex: 1;
  }

  .segmented input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .segmented span {
    display: block;
    min-height: 2.75rem;
    padding: var(--space-2);
    border-radius: calc(var(--radius-sm) - 2px);
    text-align: center;
    align-content: center;
    line-height: 1.2;
  }

  .segmented input:checked + span {
    background: var(--accent-ink);
    color: var(--bg);
    font-weight: 600;
  }

  .segmented input:focus-visible + span {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-6);
  }

  .reset {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  .note {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='reduce'])) .panel {
      transition:
        opacity var(--duration) var(--ease-out),
        translate var(--duration) var(--ease-out),
        overlay var(--duration) var(--ease-out) allow-discrete,
        display var(--duration) var(--ease-out) allow-discrete;
    }

    :global(:root:not([data-motion='reduce'])) .panel:not(:popover-open) {
      opacity: 0;
      translate: 0 0.5rem;
    }

    @starting-style {
      :global(:root:not([data-motion='reduce'])) .panel:popover-open {
        opacity: 0;
        translate: 0 0.5rem;
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .display-toggle {
        transition: scale var(--duration-fast) var(--ease-out);
      }

      .display-toggle:hover {
        scale: 1.06;
      }
    }
  }

  @media print {
    .display-toggle {
      display: none;
    }
  }
</style>
