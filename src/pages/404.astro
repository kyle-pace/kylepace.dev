---
// The 404 page, as a terminal: you tried to cd somewhere that isn't here. A small script
// fills in the address you asked for and, when it's a near miss ("/lab/", "/transt/"),
// suggests the page you probably meant. Without JavaScript it still reads fine.
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import { projects } from '../data/projects';

// Everything `ls` shows: the site's own pages, then each experiment.
const places = [
  { path: 'apps/', note: 'free apps, all about food' },
  { path: 'labs/', note: 'every experiment' },
  { path: 'how-i-build/', note: 'workflow and principles' },
  ...projects.map((p) => ({ path: `${p.slug}/`, note: p.blurb ?? p.title })),
  { path: 'connections/', note: 'what these sites load' },
];
---

<DevLayout title="Not found" accent="pink">
  <article class="lost">
    <h1><span class="code">404</span> No such file or directory.</h1>

    <div class="term" data-places={JSON.stringify(places.map((p) => p.path))}>
      <p class="term-bar" aria-hidden="true"><span>zsh</span><span>~/kylepace.dev</span></p>
      <div class="term-body">
        <p class="cmd"><span class="caret" aria-hidden="true">$</span> cd <span data-asked>~/kylepace.dev/that-page</span></p>
        <p class="err">cd: no such file or directory: <span data-asked-short>that-page</span></p>
        <p class="hint" data-hint hidden>
          zsh: did you mean <a data-hint-link href="/"></a>?
        </p>

        <p class="cmd"><span class="caret" aria-hidden="true">$</span> ls</p>
        <ul class="ls" aria-label="Pages that do exist">
          {
            places.map((p) => (
              <li>
                <a href={`/${p.path}`}>{p.path}</a>
                <span class="note">{p.note}</span>
              </li>
            ))
          }
        </ul>

        <p class="cmd last">
          <span class="caret" aria-hidden="true">$</span> <a href="/">cd ~</a><span class="cursor" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <p class="aside">Experiments come and go here. If a link from somewhere else sent you, the thing probably moved or got renamed.</p>
  </article>
</DevLayout>

<script>
  const term = document.querySelector<HTMLElement>('.term');
  if (term) {
    // The address that was asked for. textContent only, so nothing in it can run.
    const asked = decodeURIComponent(location.pathname).replace(/^\/+|\/+$/g, '').slice(0, 60) || 'that-page';
    term.querySelector('[data-asked]')!.textContent = `~/kylepace.dev/${asked}`;
    term.querySelector('[data-asked-short]')!.textContent = asked;

    // Edit distance: how many single-letter changes turn one word into another.
    const distance = (a: string, b: string) => {
      const row = Array.from({ length: b.length + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        let prev = row[0];
        row[0] = i;
        for (let j = 1; j <= b.length; j++) {
          const keep = row[j];
          row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
          prev = keep;
        }
      }
      return row[b.length];
    };

    // Suggest a real page when the first part of the address is a near miss.
    const first = asked.split('/')[0].toLowerCase();
    const places: string[] = JSON.parse(term.dataset.places ?? '[]');
    const best = places
      .map((path) => ({ path, d: distance(first, path.replace(/\/$/, '')) }))
      .sort((a, b) => a.d - b.d)[0];
    if (best && best.d > 0 && best.d <= Math.max(2, Math.floor(best.path.length / 4))) {
      const link = term.querySelector<HTMLAnchorElement>('[data-hint-link]')!;
      link.href = `/${best.path}`;
      link.textContent = best.path;
      term.querySelector<HTMLElement>('[data-hint]')!.hidden = false;
    }
  }
</script>

<style>
  .lost {
    max-width: 52rem;
    padding-block: var(--space-8) var(--space-12);
  }

  h1 {
    font-size: var(--step-3);
  }

  .code {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--accent-ink);
  }

  .term {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .term-body {
    padding: var(--space-4);
  }

  .term-body p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cmd {
    color: var(--ink);
  }

  .cmd:not(:first-child) {
    margin-top: var(--space-4);
  }

  .caret,
  .err {
    color: var(--accent-ink);
  }

  .err,
  .hint {
    padding-top: var(--space-1);
  }

  .hint {
    color: var(--ink-muted);
  }

  .hint a,
  .last a {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: 600;
  }

  .ls {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
  }

  .ls li {
    display: grid;
    grid-template-columns: minmax(10.5rem, auto) 1fr;
    gap: 0 var(--space-4);
    align-items: baseline;
  }

  .ls a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-weight: 600;
  }

  .note {
    color: var(--ink-muted);
  }

  @media (max-width: 34rem) {
    .ls li {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-2);
    }

    .ls a {
      min-height: 1.75rem;
    }
  }

  .aside {
    max-width: var(--measure);
    margin-top: var(--space-6);
    color: var(--ink-muted);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.3em;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  /* The cursor blinks four times (about 4.4 seconds), then stays solid: anything that
     blinks for more than 5 seconds needs a way to pause it (WCAG 2.2.2). */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .cursor {
      animation: blink 1.1s steps(1) 4;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
