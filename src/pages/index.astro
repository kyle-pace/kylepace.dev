---
// The hub: every experiment on kylepace.dev, from src/data/projects.ts.
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import { StatusBadge } from 'kp-design';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '../data/projects';

// Card screenshots, one per project slug (scripts/screenshot-projects.py makes them).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.png', { eager: true });
const shotFor = (slug: string) => shots[`../assets/projects/${slug}.png`]?.default;
---

<DevLayout>
  <header class="intro">
    <p class="eyebrow">Experiments by Kyle Pace</p>
    <h1>Things I’m building, in public.</h1>
    <p class="lede prose">
      Small projects I make for fun and keep refining. Expect rough edges, the occasional secret, and changes without
      notice. My portfolio, writing and case studies are on <a href="https://kylepace.net/">kylepace.net</a>.
    </p>
    <p class="principles prose">
      Every experiment follows the same <a href="/how-i-build/">development principles</a>:
      accessibility first, privacy right behind it, and nothing loaded from anyone else’s servers without a good reason.
    </p>
  </header>

  {
    projects.length > 0 ? (
      <ul class="projects">
        {projects.map((p) => (
          <li class="project" data-accent={p.accent}>
            {shotFor(p.slug) && (
              <div class="shot">
                <Image
                  src={shotFor(p.slug)!}
                  alt={p.imageAlt ?? ''}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 60rem) 30rem, 100vw"
                  format="webp"
                  quality={80}
                />
              </div>
            )}
            <p class="meta">
              Started {p.started} <StatusBadge status={p.status} />
            </p>
            <h2>
              <a href={`/${p.slug}/`}>{p.title}</a>
            </h2>
            <p>{p.summary}</p>
            <p class="source">
              <a href={`https://github.com/${p.repo}`}>
                Source<span class="visually-hidden"> for {p.title}</span> on GitHub
              </a>
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p class="prompt" aria-hidden="true">
          <span class="caret">$</span> ls experiments/<span class="cursor" />
        </p>
        <p>Nothing here yet. New experiments show up here first.</p>
      </div>
    )
  }
</DevLayout>

<style>
  .intro {
    padding-bottom: var(--space-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .principles {
    color: var(--ink-muted);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .project {
    position: relative;
    padding: var(--space-8);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6rem;
    background: radial-gradient(ellipse at 15% 0%, color-mix(in oklab, var(--accent), transparent 70%), transparent 70%);
    pointer-events: none;
  }

  /* The screenshot runs edge to edge across the top of the card. */
  .shot {
    position: relative;
    z-index: 1;
    display: block;
    margin: calc(var(--space-8) * -1) calc(var(--space-8) * -1) var(--space-6);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .shot img {
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    :root:not([data-motion='reduce']) .project:hover .shot img {
      transform: scale(1.02);
    }
  }

  .meta {
    position: relative;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  h2 {
    margin: var(--space-3) 0 var(--space-2);
  }

  h2 a {
    color: var(--ink);
  }

  /* The title link covers the whole card, so the screenshot and summary are
     clickable too, with one link per project for keyboards and screen readers. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .project p {
    color: var(--ink-muted);
  }

  .source {
    position: relative;
    z-index: 3;
    margin: var(--space-4) 0 0;
    font-size: var(--step--1);
  }

  .source a {
    color: var(--accent-ink);
  }

  /* Empty state: a terminal prompt waiting for the first experiment. */
  .empty {
    padding: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-muted);
  }

  .empty p {
    margin: 0;
  }

  .prompt {
    margin-bottom: var(--space-4) !important;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .caret {
    color: var(--accent-ink);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  /* The page's one playful moment: the cursor blinks, only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .cursor {
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
