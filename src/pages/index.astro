---
// The kylepace.dev home page: everything Kyle builds, one section each. Apps come from
// src/data/apps.ts, labs (experiments) from src/data/projects.ts. A new kind of thing
// gets its own section here.
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import { StatusBadge } from 'kp-design';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '../data/projects';
import { apps } from '../data/apps';

// Card screenshots, one per project slug (scripts/screenshot-projects.py makes them).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.png', { eager: true });
const shotFor = (slug: string) => shots[`../assets/projects/${slug}.png`]?.default;
---

<DevLayout
  description="Apps, experiments and how I build them. Small, free things Kyle Pace designs and builds after hours."
  imageAlt="kylepace.dev: things Kyle Pace is building, in public. Apps, experiments and how he builds them."
>
  <header class="intro">
    <p class="eyebrow">Built by Kyle Pace</p>
    <h1>Things I’m building, in public.</h1>
    <p class="lede prose">
      Free apps, playful experiments and whatever I’m making next, plus how I build them. My portfolio, writing and
      case studies are on <a href="https://kylepace.net/">kylepace.net</a>.
    </p>
    <p class="principles prose">
      Everything here follows the same <a href="/how-i-build/">development principles</a>: accessibility first,
      privacy right behind it, and nothing loaded from anyone else’s servers without a good reason.
    </p>
  </header>

  <section class="section" aria-labelledby="apps-heading">
    <div class="section-head">
      <h2 id="apps-heading">Apps</h2>
      <p>Small, free apps for everyday things. Right now they’re all about food.</p>
    </div>
    <ul class="apps">
      {
        apps.map((app) => (
          <li class="app" data-accent={app.accent}>
            <div class="app-icon" aria-hidden="true">
              {app.icon ? <img src={app.icon} alt="" width="56" height="56" /> : <span>{app.name[0]}</span>}
            </div>
            <div>
              <h3>
                <a href={`/apps/#${app.id}`}>{app.name}</a>
              </h3>
              <p>{app.tagline}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/apps/">All apps <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="section" aria-labelledby="labs-heading">
    <div class="section-head">
      <h2 id="labs-heading">Labs</h2>
      <p>Experiments I make for fun and keep refining. Expect rough edges, the occasional secret, and changes without notice.</p>
    </div>
  {
    projects.length > 0 ? (
      <ul class="projects">
        {projects.map((p) => (
          <li class="project" data-accent={p.accent}>
            {shotFor(p.slug) && (
              <div class="shot">
                <Image
                  src={shotFor(p.slug)!}
                  alt={p.imageAlt ?? ''}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 60rem) 30rem, 100vw"
                  format="webp"
                  quality={80}
                />
              </div>
            )}
            <p class="meta">
              Started {p.started} <StatusBadge status={p.status} />
            </p>
            <h3>
              <a href={`/${p.slug}/`}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <p class="source">
              <a href={`https://github.com/${p.repo}`}>
                Source<span class="visually-hidden"> for {p.title}</span> on GitHub
              </a>
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p class="prompt" aria-hidden="true">
          <span class="caret">$</span> ls experiments/<span class="cursor" />
        </p>
        <p>Nothing here yet. New experiments show up here first.</p>
      </div>
    )
  }
  </section>

  <section class="section how" aria-labelledby="how-heading">
    <h2 id="how-heading">How I build</h2>
    <p>
      I’m a product manager who ships software with AI coding agents. Here’s how that works, and the principles every
      project follows.
    </p>
    <p class="more"><a href="/how-i-build/">Read how I build <span aria-hidden="true">→</span></a></p>
  </section>
</DevLayout>

<style>
  .intro {
    padding-bottom: var(--space-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .principles {
    color: var(--ink-muted);
  }

  /* Each kind of thing gets a section: a heading, a line about it, then its cards. */
  .section {
    margin-top: var(--space-16);
  }

  .section-head {
    margin-bottom: var(--space-6);
  }

  .section-head h2,
  .how h2 {
    margin: 0 0 var(--space-2);
  }

  .section-head p,
  .how p:not(.more) {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .more {
    margin: var(--space-6) 0 0;
    font-weight: 600;
  }

  /* Apps: a compact row, icon beside name and tagline. The full cards live on /apps/. */
  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .app {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .app:hover {
    border-color: var(--accent);
  }

  .app-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.9rem;
    background: var(--accent);
  }

  .app-icon img {
    width: 72%;
    height: auto;
  }

  .app-icon span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: color-mix(in oklab, var(--accent), black 55%);
  }

  .app h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
  }

  .app h3 a {
    color: var(--ink);
  }

  /* The name links; its hit area covers the whole card. */
  .app h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .app p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .how {
    padding: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .project {
    position: relative;
    padding: var(--space-8);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6rem;
    background: radial-gradient(ellipse at 15% 0%, color-mix(in oklab, var(--accent), transparent 70%), transparent 70%);
    pointer-events: none;
  }

  /* The screenshot runs edge to edge across the top of the card. */
  .shot {
    position: relative;
    z-index: 1;
    display: block;
    margin: calc(var(--space-8) * -1) calc(var(--space-8) * -1) var(--space-6);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .shot img {
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    :root:not([data-motion='reduce']) .project:hover .shot img {
      transform: scale(1.02);
    }
  }

  .meta {
    position: relative;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .project h3 {
    margin: var(--space-3) 0 var(--space-2);
    font-size: var(--step-2);
  }

  .project h3 a {
    color: var(--ink);
  }

  /* The title link covers the whole card, so the screenshot and summary are
     clickable too, with one link per project for keyboards and screen readers. */
  .project h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .project p {
    color: var(--ink-muted);
  }

  .source {
    position: relative;
    z-index: 3;
    margin: var(--space-4) 0 0;
    font-size: var(--step--1);
  }

  .source a {
    color: var(--accent-ink);
  }

  /* Empty state: a terminal prompt waiting for the first experiment. */
  .empty {
    padding: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-muted);
  }

  .empty p {
    margin: 0;
  }

  .prompt {
    margin-bottom: var(--space-4) !important;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .caret {
    color: var(--accent-ink);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  /* The page's one playful moment: the cursor blinks, only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .cursor {
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
