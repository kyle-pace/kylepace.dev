---
// The kylepace.dev home page: an overview of everything Kyle builds, with a short preview
// of each kind of thing. The full lists have their own pages: /apps/ (src/data/apps.ts)
// and /labs/ (src/data/projects.ts). A new kind of thing gets its own section here.
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import { projects } from '../data/projects';
import { apps } from '../data/apps';
---

<DevLayout
  description="Apps, experiments and how I build them. Small, free things Kyle Pace designs and builds after hours."
  imageAlt="kylepace.dev: things Kyle Pace is building, in public. Apps, experiments and how he builds them."
>
  <header class="intro">
    <p class="path" aria-hidden="true"><span class="caret">~/</span>kylepace.dev</p>
    <h1>Things I’m building, in public.<span class="cursor" aria-hidden="true"></span></h1>
    <p class="lede prose">
      Free apps, playful experiments and whatever I’m making next, plus how I build them. My portfolio, writing and
      case studies are on <a href="https://kylepace.net/">kylepace.net</a>.
    </p>

    <!-- A small terminal: what's on this site, as links, and the principles every project follows. -->
    <div class="term">
      <p class="term-bar" aria-hidden="true"><span>zsh</span><span>~/projects</span></p>
      <div class="term-body">
        <p class="cmd" aria-hidden="true"><span class="caret">$</span> ls ~/projects</p>
        <ul class="ls" aria-label="What’s on this site">
          <li>
            <a href="/apps/"><span class="dir">apps/</span></a>
            <span class="note">{apps.length} free apps, all about food</span>
          </li>
          <li>
            <a href="/labs/"><span class="dir">labs/</span></a>
            <span class="note">{projects.length} experiments, rough edges included</span>
          </li>
          <li>
            <a href="/how-i-build/"><span class="dir">how-i-build/</span></a>
            <span class="note">my workflow and the principles below</span>
          </li>
        </ul>
        <p class="cmd" aria-hidden="true"><span class="caret">$</span> cat principles.txt</p>
        <p class="out">
          Accessibility first. Privacy right behind it. Nothing loaded from anyone else’s servers without a good reason.
        </p>
      </div>
    </div>
  </header>

  <section class="section" id="apps" aria-labelledby="apps-heading">
    <div class="section-head">
      <h2 id="apps-heading">Apps</h2>
      <p>Small, free apps for everyday things. Right now they’re all about food.</p>
    </div>
    <ul class="apps">
      {
        apps.map((app) => (
          <li class="app" data-accent={app.accent}>
            <div class="app-icon" aria-hidden="true">
              {app.icon ? <img src={app.icon} alt="" width="56" height="56" /> : <span>{app.name[0]}</span>}
            </div>
            <div>
              <h3>
                <a href={`/apps/#${app.id}`}>{app.name}</a>
              </h3>
              <p>{app.tagline}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/apps/">All apps <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="section" id="labs" aria-labelledby="labs-heading">
    <div class="section-head">
      <h2 id="labs-heading">Labs</h2>
      <p>Experiments I make for fun and keep refining. Expect rough edges, the occasional secret, and changes without notice.</p>
    </div>
    <ul class="labs">
      {
        projects.map((p) => (
          <li class="lab" data-accent={p.accent}>
            <h3>
              <a href={`/${p.slug}/`}>{p.title}</a>
            </h3>
            <p>{p.blurb ?? p.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/labs/">All labs <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="section how" aria-labelledby="how-heading">
    <h2 id="how-heading">How I build</h2>
    <p>
      I’m a product manager who ships software with AI coding agents. Here’s how that works, and the principles every
      project follows.
    </p>
    <p class="more"><a href="/how-i-build/">Read how I build <span aria-hidden="true">→</span></a></p>
  </section>
</DevLayout>

<style>
  .intro {
    padding-bottom: var(--space-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  /* The top of the page reads like a terminal: a path above the headline, a cursor after it. */
  .path {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .caret {
    color: var(--accent-ink);
  }

  h1 .cursor {
    height: 0.8em;
    width: 0.45em;
    margin-left: 0.12em;
    vertical-align: -0.04em;
  }

  .term {
    max-width: 44rem;
    margin-top: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .term-body {
    padding: var(--space-4) var(--space-4) var(--space-2);
  }

  .term p {
    margin: 0 0 var(--space-2);
  }

  .cmd {
    color: var(--ink);
  }

  .ls {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .ls li {
    display: grid;
    grid-template-columns: minmax(9.5rem, auto) 1fr;
    gap: 0 var(--space-4);
    align-items: baseline;
  }

  .ls a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .note,
  .out {
    color: var(--ink-muted);
  }

  .out {
    padding-bottom: var(--space-2);
  }

  @media (max-width: 30rem) {
    .ls li {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-2);
    }

    .ls a {
      min-height: 2.25rem;
    }
  }

  /* Each kind of thing gets a section: a heading, a line about it, then its cards. */
  .section {
    margin-top: var(--space-16);
  }

  .section-head {
    margin-bottom: var(--space-6);
  }

  .section-head h2,
  .how h2 {
    margin: 0 0 var(--space-2);
  }

  .section-head p,
  .how p:not(.more) {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .more {
    margin: var(--space-6) 0 0;
    font-weight: 600;
  }

  /* Apps: a compact row, icon beside name and tagline. The full cards live on /apps/. */
  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .app {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .app:hover {
    border-color: var(--accent);
  }

  .app-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.9rem;
    background: var(--accent);
  }

  .app-icon img {
    width: 72%;
    height: auto;
  }

  .app-icon span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: color-mix(in oklab, var(--accent), black 55%);
  }

  .app h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
  }

  .app h3 a {
    color: var(--ink);
  }

  /* The name links; its hit area covers the whole card. */
  .app h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .app p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .how {
    padding: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  /* Labs: a compact list, one line each. The full cards with screenshots live on /labs/. */
  .labs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .lab {
    position: relative;
    padding: var(--space-4) var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }

  .lab:hover {
    border-color: var(--accent);
  }

  .lab h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
  }

  .lab h3 a {
    color: var(--ink);
  }

  /* The name links; its hit area covers the whole card. */
  .lab h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .lab p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  /* The page's one playful moment: the cursor blinks, only when motion is welcome, and
     only four times (about 4.4 seconds). Anything that blinks longer than 5 seconds needs a
     way to pause it (WCAG 2.2.2), so it settles into a solid block instead. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .cursor {
      animation: blink 1.1s steps(1) 4;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
