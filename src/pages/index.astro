---
// The kylepace.dev home page. The top shows the work itself: a shelf with a screenshot of
// every app and lab, the one worked on most recently first, then a short ship log of what
// changed lately. The full lists have their own pages: /apps/ (src/data/apps.ts), /labs/
// (src/data/projects.ts) and /log/ (src/data/log.ts and src/data/next.ts).
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '../data/projects';
import { apps } from '../data/apps';
import { byRecent, entries, shortDate, longDate } from '../lib/log';

// Screenshots, made by scripts/screenshot-projects.py.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/{projects,apps}/*.png', { eager: true });
const shot = (path: string) => shots[`../assets/${path}.png`]?.default;

// Apps and labs together, whatever was worked on most recently first (src/lib/log.ts).
const shelf = byRecent(
  [
    ...apps.map((a) => ({
      about: a.id,
      kind: 'app',
      title: a.name,
      href: `/apps/#${a.id}`,
      blurb: a.tagline,
      accent: a.accent,
      image: shot(`apps/${a.id}`),
      imageAlt: a.imageAlt ?? '',
    })),
    ...projects.map((p) => ({
      about: p.slug,
      kind: 'lab',
      title: p.title,
      href: `/${p.slug}/`,
      blurb: p.blurb ?? p.summary,
      accent: p.accent,
      image: shot(`projects/${p.slug}`),
      imageAlt: p.imageAlt ?? '',
    })),
  ],
  (item) => item.about,
);

const recent = entries.slice(0, 5);
---

<DevLayout
  title="Kyle Pace"
  description="Apps, experiments and how I build them. Small, free things Kyle Pace designs and builds after hours."
  imageAlt="kylepace.dev: things Kyle Pace is building, in public. Apps, experiments and how he builds them."
>
  <header class="intro">
    <p class="path" aria-hidden="true"><span class="caret">~/</span>kylepace.dev</p>
    <h1>Things I’m building, in public.<span class="cursor" aria-hidden="true"></span></h1>
    <p class="lede prose">
      Free apps and playful experiments, plus how I build them.
      My portfolio, writing and case studies are on <a href="https://kylepace.net/">kylepace.net</a>.
    </p>
  </header>

  <!-- The shelf: every app and lab, screenshot first. -->
  <section class="shelf-wrap" aria-labelledby="shelf-heading">
    <h2 id="shelf-heading" class="visually-hidden">Apps and labs</h2>
    <ul class="shelf">
      {
        shelf.map((item) => (
          <li class="item" data-accent={item.accent}>
            <div class="shot">
              {item.image ? (
                <Image
                  src={item.image}
                  alt={item.imageAlt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
                  format="webp"
                  quality={80}
                />
              ) : (
                <span class="shot-empty" aria-hidden="true">
                  {item.title[0]}
                </span>
              )}
            </div>
            <div class="item-text">
              <p class="kind">{item.kind}</p>
              <h3>
                <a href={item.href}>{item.title}</a>
              </h3>
              <p class="blurb">{item.blurb}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a href="/apps/">All apps <span aria-hidden="true">→</span></a>
      <a href="/labs/">All labs <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <!-- The ship log: what changed lately, kept by hand in src/data/log.ts. The rest is on /log/. -->
  <section class="term" aria-labelledby="log-heading">
    <div class="term-bar">
      <h2 id="log-heading"><span aria-hidden="true">git log</span><span class="visually-hidden">Recently shipped</span></h2>
      <span aria-hidden="true">~/projects</span>
    </div>
    <div class="term-body">
      <p class="cmd" aria-hidden="true"><span class="caret">$</span> git log --all --oneline</p>
      <ol class="log">
        {
          recent.map((entry) => (
            <li>
              <time datetime={entry.date}>
                <span aria-hidden="true">{shortDate(entry.date)}</span>
                <span class="visually-hidden">{longDate(entry.date)}:</span>
              </time>
              <a href={entry.href}>{entry.label}</a>
              <span class="msg">{entry.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <p class="more">
    <a href="/log/">Full log and what’s next <span aria-hidden="true">→</span></a>
  </p>

  <section class="section how" aria-labelledby="how-heading">
    <h2 id="how-heading">How I build</h2>
    <p>
      I’m a product manager who ships software with AI coding agents. Here’s how that works, and the principles every
      project follows: accessibility first, privacy right behind it.
    </p>
    <p class="more"><a href="/how-i-build/">Read how I build <span aria-hidden="true">→</span></a></p>
  </section>
</DevLayout>

<style>
  .intro {
    padding-bottom: var(--space-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  /* The top of the page reads like a terminal: a path above the headline, a cursor after it. */
  .path {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .caret {
    color: var(--accent-ink);
  }

  h1 .cursor {
    height: 0.8em;
    width: 0.45em;
    margin-left: 0.12em;
    vertical-align: -0.04em;
  }

  /* The shelf: a screenshot of every app and lab. Three across on wide screens. */
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .item:hover {
    border-color: var(--accent);
  }

  .shot {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background: color-mix(in oklab, var(--accent), var(--bg) 70%);
  }

  .shot img,
  .shot-empty {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .shot-empty {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    color: var(--accent-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .shot img {
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    :root:not([data-motion='reduce']) .item:hover .shot img {
      transform: scale(1.03);
    }
  }

  .item-text {
    padding: var(--space-4) var(--space-4) var(--space-4);
  }

  .kind {
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
  }

  .item h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
  }

  .item h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .item:hover h3 a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  /* The name links; its hit area covers the whole card. */
  .item h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .blurb {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0 0;
    font-weight: 600;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 2.75rem;
  }

  /* The ship log: a small terminal with the latest changes. */
  .term {
    max-width: 52rem;
    margin-top: var(--space-12);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .term-bar h2 {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .term-body {
    padding: var(--space-4);
  }

  .cmd {
    margin: 0 0 var(--space-3);
    color: var(--ink);
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log li {
    display: grid;
    grid-template-columns: 4.5rem 9.5rem 1fr;
    gap: 0 var(--space-4);
    align-items: baseline;
    padding-block: var(--space-1);
  }

  .log time,
  .msg {
    color: var(--ink-muted);
  }

  .log a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .log li {
      grid-template-columns: auto 1fr;
      padding-block: var(--space-2);
    }

    .msg {
      grid-column: 1 / -1;
    }
  }

  .term + .more {
    margin-top: var(--space-3);
  }

  .section {
    margin-top: var(--space-16);
  }

  .how {
    padding: var(--space-8);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  .how h2 {
    margin: 0 0 var(--space-2);
  }

  .how p:not(.more) {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
  }

  /* The page's one playful moment: the cursor blinks, only when motion is welcome, and
     only four times (about 4.4 seconds). Anything that blinks longer than 5 seconds needs a
     way to pause it (WCAG 2.2.2), so it settles into a solid block instead. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='reduce']) .cursor {
      animation: blink 1.1s steps(1) 4;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
