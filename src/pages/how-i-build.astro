---
// How Kyle builds with AI coding agents. A short, human-facing summary of the
// principles; the full rules the agents follow live in github.com/kyle-pace/principles.
import DevLayout from 'kp-design/layouts/DevLayout.astro';

export const prerender = true;

const REPO_URL = 'https://github.com/kyle-pace/principles';
---

<DevLayout
  title="How I build"
  description="How a product manager ships apps and sites with AI coding agents, and the principles every project follows."
  image="/og-how-i-build.png"
  imageAlt="How I build: a product manager who ships software, with AI agents and a shared set of principles."
>
  <article class="page">
    <header class="top">
      <p class="path" aria-hidden="true"><span class="caret">~/</span>how-i-build</p>
      <h1>A product manager who ships software.</h1>
      <p class="lede">
        I’m Director of Product at <a href="https://www.localpublic.tv/">Local Public TV</a>. On nights and weekends I
        build apps and sites with AI coding agents. I don’t write the code by hand; I run each project the way I’d run
        a product team.
      </p>
    </header>

    <section class="row" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        <li><strong>Brief the outcome.</strong> Who it’s for, what it should do, what it shouldn’t.</li>
        <li><strong>Set the rules once.</strong> One set of principles syncs into every project, so any agent starts from the same standards.</li>
        <li><strong>Review everything.</strong> I read every result and try it before it ships. Less manager, more editor.</li>
        <li><strong>Ship small.</strong> Automated checks catch what I miss, and changes go out in pieces I can actually check.</li>
      </ol>
    </section>

    <section class="row" aria-labelledby="principles">
      <h2 id="principles">The principles</h2>
      <div class="body">
        <ul class="principles">
          <li id="accessibility"><strong>Accessibility first.</strong> WCAG AA, keyboard friendly, light and dark, from the first commit.</li>
          <li id="privacy"><strong>Privacy right behind.</strong> The least data that answers a real question. No ad pixels, no analytics cookies, no selling data.</li>
          <li id="screens"><strong>Every screen size.</strong> Phone, tablet and desktop from day one.</li>
          <li id="self-host"><strong>Self-host everything.</strong> No CDNs. Each outside service is approved one at a time (<a href="/connections/">here’s the list</a>).</li>
          <li id="simple"><strong>Simple and fast.</strong> Static by default, small pages, plain language.</li>
        </ul>
        <p class="more">
          <a href={REPO_URL}>The full rules the agents follow, on GitHub <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>
  </article>
</DevLayout>

<style>
  .top {
    max-width: 52rem;
  }

  .path {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .caret {
    color: var(--accent-ink);
  }

  h1 {
    max-width: 16ch;
  }

  .lede {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .row {
    margin-top: var(--space-16);
  }

  .row h2 {
    margin-top: 0;
  }

  .body {
    max-width: var(--measure);
  }

  /* Steps: a numbered list, the number large and in the accent color. */
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 2.5rem;
    max-width: var(--measure);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.2em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--accent-ink);
  }

  .principles {
    margin: 0;
    padding-left: 1.25rem;
  }

  .principles li + li {
    margin-top: var(--space-3);
  }

  .more {
    margin-top: var(--space-6);
  }

  /* Wide screens: headings in a left column beside the text. */
  @media (min-width: 64rem) {
    .row {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 0 var(--space-12);
      align-items: start;
    }

    .row h2 {
      font-size: var(--step-1);
    }
  }
</style>
